# Copy this file to .env and change what you need.
# Command-line options (python main.py --help) override these values.

TIKI_INPUT_FILE=products-0-200000.csv
TIKI_OUTPUT_DIR=output
TIKI_WORKERS=1
TIKI_START_DELAY=0.6
TIKI_MIN_DELAY=0.45
TIKI_MAX_DELAY=10
TIKI_BLOCK_PAUSE=300
TIKI_MAX_BLOCK_PAUSE=900

# auto = pycurl if installed, otherwise the curl binary
TIKI_TRANSPORT=auto
# Only for TIKI_TRANSPORT=curl; leave empty to use curl from PATH
TIKI_CURL_PATH=

# LLM enrichment (python -m enrichment.<step>, see docs/llm_enrichment_spec.md)
ENRICH_SAMPLE_SIZE=1000
ENRICH_SEED=42
LLM_MAX_INPUT_CHARS=2000
ENRICH_WORKERS=4
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Your own key from console.anthropic.com. Never commit .env.
LLM_API_KEY=
LLM_MAX_COST_USD=2
